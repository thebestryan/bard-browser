{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "**/*.test.mjs",
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "vite.config.js",
        "*.config.js"
      ],
      "globals": {
        "process": "readonly"
      }
    }
  ]
}
